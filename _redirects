# Cloudflare Pages Routing & Rewrites
# Product-track page:     deepak-bharadwaj.com/portfolio  -> index.html
# Engineering-track page: deepak-bharadwaj.com/website    -> website.html
# (Cloudflare Pages serves website.html at /website automatically; the
#  trailing-slash variant is normalised below so both links resolve.)

/portfolio              /index.html             200
/portfolio/             /index.html             200
/portfolio/*            /:splat                 200

/website/               /website                301
